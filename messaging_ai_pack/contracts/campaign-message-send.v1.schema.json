{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-message-send.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "organizationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "campaign.message.send"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "campaignId",
        "runId",
        "campaignContactId",
        "attempt"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "campaignContactId": {
          "type": "string",
          "minLength": 1
        },
        "requestedByUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    }
  }
}
